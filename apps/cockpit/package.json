{
  "name": "@converge/cockpit",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Read-only operational cockpit for a local Converge workspace.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b && node --test server/*.test.mjs && vitest run",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs --serve-dist"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.2",
    "@agentclientprotocol/codex-acp": "1.1.9",
    "@agentclientprotocol/sdk": "1.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.2",
    "motion": "12.43.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
