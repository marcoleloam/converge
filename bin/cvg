# ---------------------------------------------------------------------------
# Agent-native output layer (2026 SOTA): --json envelope + --dry-run on mutations
# ---------------------------------------------------------------------------
# Both are GLOBAL flags, recognized in ANY position and stripped before routing.
# The DEFAULT path is byte-parity-untouched; --json is a pure WRAPPER that
# re-invokes the command, captures its output+exit, and emits one uniform envelope
# {ok, data, error, meta}. One interception point → zero per-gate refactor, so no
# proven gate loses its behavior. --dry-run short-circuits a mutating command.

# is_mutating <cmd> [args...] — 0 if the command changes state on disk.
is_mutating() {
  local c="$1" sub a; shift
  case "$c" in
    init)       return 0 ;;
    transition) return 0 ;;
    tasks)
      sub="${1:-}"; [ $# -gt 0 ] && shift
      case "$sub" in
        new|accept|rebuild-state) return 0 ;;
        validate)
          for a in "$@"; do [ "$a" = "--no-state" ] && return 1; done
          return 0
          ;;
        gate)
          for a in "$@"; do
            case "$a" in --stamp|--stamp-by|--stamp-by=*) return 0 ;; esac
          done
          return 1
          ;;
        *) return 1 ;;
      esac
      ;;
    decompose)  return 0 ;;
    review)     for a in "$@"; do case "$a" in --adversary|--adversary=*|--resolve|--resolve=*) return 0 ;; esac; done; return 1 ;;
    compose)
      case "${1:-}" in
        prepare|review|preview|materialize) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    bind)       for a in "$@"; do [ "$a" = "--check" ] && return 1; done; return 0 ;;
    # cvg strips --dry-run from "$@" before this guard runs, so scanning args
    # here would be dead code — consult the parsed flag. The loop kernel owns
    # its own dry-run because it reports the resolved budgets, which is the part
    # worth reading before letting a run go unattended.
    loop)       [ "$CVG_DRY_RUN" -eq 1 ] && return 1
                for a in "$@"; do
                  case "$a" in --estimate|--gate-only) return 1 ;; esac
                done
                return 0 ;;
    register)   for a in "$@"; do [ "$a" = "--check" ] && return 1; done; return 0 ;;
    setup)
      case "${1:-}" in
        signing|tracker|repo|projection|key|harness) return 0 ;;
        identity)
          shift
          for a in "$@"; do
            case "$a" in --map|--map=*) return 0 ;; esac
          done
          return 1
          ;;
        *) return 1 ;;
      esac
      ;;
    snapshot)    return 1 ;;
    *)          return 1 ;;
  esac
}

# cvg_envelope <cmd> <args-joined> <exit_code> <dry_run> <raw_output_file> <mutating>
# Emits the uniform {ok,command,token,verdict,exit_code,changed,dry_run,data,error,
# warnings,meta} envelope. Python stdlib only (no deps). The raw output is passed via
# a FILE, not stdin — `python3 - <<'PY'` already owns stdin (the program).
cvg_envelope() {
  CVG_ENV_VERSION="$CVG_VERSION" python3 - "$1" "$2" "$3" "$4" "${5:-}" "${6:-0}" <<'PY'
import json, sys, os, re
cmd, args, rc, dry, rawfile, mutating = (
    sys.argv[1], sys.argv[2], int(sys.argv[3]), (sys.argv[4] == "1"),
    sys.argv[5], (sys.argv[6] == "1"),
)
raw = open(rawfile, encoding="utf-8", errors="replace").read() if (rawfile and os.path.exists(rawfile)) else ""
raw = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', raw)
token = verdict = None
changed_override = None
for line in raw.splitlines():
    changed_match = re.match(r'^CHANGED=(true|false|1|0)$', line.strip(), re.I)
    if changed_match:
        changed_override = changed_match.group(1).lower() in {"true", "1"}
        continue
    m = re.match(r'^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_.|-]+)\s*$', line.strip())
    if m:
        token, verdict = line.strip(), m.group(2)   # last token wins
ok = (rc == 0)
disp = cmd
parts = args.split()
if cmd == "tasks":
    sub = parts[0] if parts else ""
    disp = ("tasks " + sub).strip()
elif cmd == "review":
    pass
elif cmd == "register":
    disp = "register --check" if ("--check" in parts) else "register"
elif cmd == "bind":
    disp = "bind --check" if ("--check" in parts) else "bind"
elif cmd == "setup":
    sub = parts[0] if parts else "status"
    disp = ("setup " + sub).strip() if sub != "status" else "setup"
elif cmd == "compose":
    sub = parts[0] if parts else ""
    disp = ("compose " + sub).strip()
PASS = {"capture": 0, "intent": 1, "structure": 2, "decompose": 3, "review": 4, "doctor": 4, "bind": 7, "loop": 8}
data = {"output": raw.rstrip("\n")}
next_action = next(
    (line[len("NEXT="):] for line in raw.splitlines() if line.startswith("NEXT=")),
    None,
)
if next_action is not None:
    data["next_action"] = next_action
parsed = None
try:
    parsed = json.loads(raw)
except (TypeError, ValueError):
    pass
if cmd == "snapshot" and ok:
    snapshot = parsed
    if isinstance(snapshot, dict) and snapshot.get("schemaVersion") == "3.0":
        data = {"snapshot": snapshot}
elif cmd in {"agent-context", "manifest"} and isinstance(parsed, dict):
    data = {"agent_context": parsed}
unchanged_verdicts = {"UNCHANGED", "EMPTY", "DRY_RUN", "EXISTS", "DISABLED", "UNMANAGED", "NO_OP"}
changed = mutating and ok and not dry
if verdict in unchanged_verdicts or (isinstance(verdict, str) and "UNCHANGED" in verdict):
    changed = False
if changed_override is not None:
    changed = changed_override
error_code = "USAGE_ERROR" if rc == 2 else ("ENGINE_UNAVAILABLE" if rc == 3 else (verdict or "ERROR"))
env = {
    "contract": "ConvergeCLIResult/v1",
    "schema_version": 1,
    "ok": ok, "command": disp, "converge_pass": PASS.get(cmd),
    "token": token, "verdict": verdict, "exit_code": rc,
    "changed": changed, "dry_run": dry,
    "data": data,
    "error": (None if ok else {"code": error_code,
              "message": (raw.strip().splitlines()[-1] if raw.strip() else "command failed")}),
    "warnings": [],
    "meta": {"schema_version": "1.0", "tool": "cvg",
             "cvg_version": os.environ.get("CVG_ENV_VERSION", "0")},
}
print(json.dumps(env, indent=2))
PY
}

# ---------------------------------------------------------------------------
# Router
# ---------------------------------------------------------------------------
CVG_JSON=0; CVG_DRY_RUN=0
_ARGS=()
for _a in "$@"; do
  case "$_a" in
    --json)    CVG_JSON=1 ;;
    --dry-run) CVG_DRY_RUN=1 ;;
    *)         _ARGS+=("$_a") ;;
  esac
done
# shellcheck disable=SC2086  # intentional: empty-array-safe re-set of positional args (bash 3.2)
set -- ${_ARGS[@]+"${_ARGS[@]}"}
CMD="${1:-help}"
[ $# -gt 0 ] && shift

# --dry-run on a MUTATING command: report the intended action, change nothing.
if [ "$CVG_DRY_RUN" -eq 1 ] && is_mutating "$CMD" "$@"; then
  if [ "$CVG_JSON" -eq 1 ]; then
    cvg_envelope "$CMD" "$*" 0 1 "" 1
  else
    printf 'DRY-RUN: would run: cvg %s %s — no changes made.\n' "$CMD" "$*" >&2
    printf 'DRY_RUN=OK\n'
  fi
  exit 0
fi

# --json: re-invoke the command (flags already stripped), capture output+exit,
# and envelope EVERY public form, including help, version, and agent-context.
if [ "$CVG_JSON" -eq 1 ]; then
      _J_RC=0
      _J_MUT=0
      _J_TMP="$(mktemp)"
      is_mutating "$CMD" "$@" && _J_MUT=1
      if [ "$CVG_DRY_RUN" -eq 1 ]; then
        bash "$0" --dry-run "$CMD" "$@" > "$_J_TMP" 2>&1 || _J_RC=$?
      else
        bash "$0" "$CMD" "$@" > "$_J_TMP" 2>&1 || _J_RC=$?
      fi
      cvg_envelope "$CMD" "$*" "$_J_RC" "$CVG_DRY_RUN" "$_J_TMP" "$_J_MUT"
      rm -f "$_J_TMP"
      exit "$_J_RC"
fi

case "$CMD" in
  help|--help|-h)
    if [ $# -gt 0 ]; then
      ui_err "cvg help takes no arguments"
      exit 2
    fi
    CVG_HOME_DIR="(unresolved)"
    cmd_help
    exit 0
    ;;
esac

CVG_HOME_DIR="$(resolve_home)" || exit 1
CVG_PROJECT_ROOT_DIR="$(resolve_project_root)" || exit 1
export CVG_TOOL_HOME="$CVG_HOME_DIR"
export CVG_PROJECT_ROOT="$CVG_PROJECT_ROOT_DIR"
# Compatibility for existing adapters that use CVG_HOME_DIR as their tool root.
export CVG_HOME_DIR
if [ "$CMD" = "compose" ] || [ "$CMD" = "decompose" ] || [ "$CMD" = "_observe-decomposition" ]; then
  TASKSPEC_BIN="${CVG_TASKSPEC_BIN:-$(command -v taskspec 2>/dev/null || true)}"
else
  TASKSPEC_BIN="$(resolve_taskspec)" || exit 3
fi
export TASKSPEC_BIN
if [ -z "${TASKSPEC_BACKLOG_DIR:-}" ]; then
  if [ -d "$CVG_PROJECT_ROOT_DIR/cvg/tasks" ]; then
    TASKSPEC_BACKLOG_DIR="$CVG_PROJECT_ROOT_DIR/cvg/tasks"
  elif [ -d "$CVG_PROJECT_ROOT_DIR/tasks" ]; then
    TASKSPEC_BACKLOG_DIR="$CVG_PROJECT_ROOT_DIR/tasks"
  else
    TASKSPEC_BACKLOG_DIR="$CVG_PROJECT_ROOT_DIR/cvg/tasks"
  fi
fi
export TASKSPEC_BACKLOG_DIR
export TASKSPEC_WORKSPACE_ROOT="$CVG_PROJECT_ROOT_DIR"
if [ -z "${TASKSPEC_ACCEPTANCE_DIR:-}" ]; then
  TASKSPEC_ACCEPTANCE_DIR="$(dirname "$TASKSPEC_BACKLOG_DIR")/.taskspec/acceptance"
fi
export TASKSPEC_ACCEPTANCE_DIR

case "$CMD" in
  compose)
    COMPOSER="$CVG_HOME_DIR/bin/_cvg_compose.py"
    [ -f "$COMPOSER" ] || {
      ui_err "Converge composition coordinator is missing under $CVG_HOME_DIR/bin"
      printf 'COMPOSE=BLOCKED\n'
      exit 2
    }
    exec python3 "$COMPOSER" \
      --project-root "$CVG_PROJECT_ROOT_DIR" \
      --cvg-version "$CVG_VERSION" \
      --seamwise-bin "${CVG_SEAMWISE_BIN:-}" \
      --taskspec-bin "$TASKSPEC_BIN" \
      "$@"
    ;;
  init)
    cvg_init "$@"
    ;;
  tasks)
    SUB="${1:-}"
    [ $# -gt 0 ] && shift
    case "$SUB" in
      plan)     route_taskspec plan "$@" ;;
      new)      route_taskspec new "$@" ;;
      validate) route_taskspec validate "$@" ;;
      gate)     route_taskspec gate "$@" ;;
      accept)   cvg_tasks_accept "$@" ;;
      dod)      route_taskspec dod "$@" ;;
      metrics)  route_taskspec metrics "$@" ;;
      # `_state.yaml` declares itself "Auto-generated by rebuild-state.sh — DO NOT
      # EDIT DIRECTLY / Source of truth: frontmatter in each tasks/T-*.md", and the
      # only thing that ran it was `cvg init`, guarded on the file being ABSENT. So
      # it was generated once and never again: after authoring and sealing four
      # specs it still carried the scaffolding run's timestamps. The concepts doc
      # told readers to bypass the CLI for the Task-Spec rebuild script. The
      # public standalone engine now owns that behavior as `taskspec rebuild-state`.
      rebuild-state)
        if [ $# -gt 0 ]; then
          ui_err "cvg tasks rebuild-state takes no arguments"
          printf 'TASKS_REBUILD_STATE=USAGE_ERROR\n'
          exit 2
        fi
        route_taskspec rebuild-state
        ;;
      *)
        ui_err "unknown tasks subcommand '${SUB:-}' — expected: new | validate | gate | accept | dod | metrics | rebuild-state"
        exit 2
        ;;
    esac
    ;;
  bind)
    # Pass 7 · Bind. The Task-Spec stays canonical; this command writes or
    # verifies the thin, hash-bound execution profile and concrete guards.
    BINDER="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/bind-runtime-contract.py"
    CHECKER="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/check-runtime-contract.py"
    [ -f "$BINDER" ] && [ -f "$CHECKER" ] || {
      ui_err "task-to-runtime-contract skill is incomplete under $CVG_HOME_DIR/skills"
      printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
      exit 2
    }
    BIND_CHECK=0
    BIND_TASK=""
    BIND_PROFILE=""
    BIND_SUPERVISED=0
    BIND_ARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --check) BIND_CHECK=1; shift ;;
        --task)
          [ $# -ge 2 ] || {
            ui_err "--task requires a Task-Spec path"
            printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
            exit 2
          }
          BIND_TASK="$2"; BIND_ARGS+=(--task "$2"); shift 2 ;;
        --task=*)
          BIND_TASK="${1#--task=}"; BIND_ARGS+=("$1"); shift ;;
        --profile)
          [ $# -ge 2 ] || {
            ui_err "--profile requires an execution-profile path"
            printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
            exit 2
          }
          BIND_PROFILE="$2"; shift 2 ;;
        --profile=*) BIND_PROFILE="${1#--profile=}"; shift ;;
        --supervised)
          BIND_SUPERVISED=1; BIND_ARGS+=("$1"); shift ;;
        *)
          if [ "$BIND_CHECK" -eq 1 ]; then
            ui_err "unknown bind --check argument '$1'"
            printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
            exit 2
          fi
          BIND_ARGS+=("$1"); shift ;;
      esac
    done
    if [ "$BIND_CHECK" -eq 1 ]; then
      if [ -z "$BIND_PROFILE" ]; then
        if [ -z "$BIND_TASK" ]; then
          ui_err "bind --check requires --task <spec> or --profile <profile>"
          printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
          exit 2
        fi
        BIND_ID="$(basename "$BIND_TASK" .md)"
        BIND_PROFILE="$CVG_PROJECT_ROOT_DIR/cvg/execution/$BIND_ID/execution-profile.yaml"
      fi
      BIND_CHECK_ARGS=(--profile "$BIND_PROFILE" --repo "$CVG_PROJECT_ROOT_DIR" --tool-home "$CVG_HOME_DIR")
      [ "$BIND_SUPERVISED" -eq 1 ] && BIND_CHECK_ARGS+=(--supervised)
      exec python3 "$CHECKER" "${BIND_CHECK_ARGS[@]}"
    fi
    if [ -z "$BIND_TASK" ]; then
      ui_err "bind requires --task <Task-Spec>"
      printf 'CHECK_RUNTIME_CONTRACT=FAIL\n'
      exit 2
    fi
    BIND_ID="$(basename "$BIND_TASK" .md)"
    # Bind writes canonical, commit-worthy policy. TaskHandoff/v3 is deliberately
    # NOT minted here: its immutable Git base and workspace only exist after the
    # Manager/loop has created the final dispatch worktree. The loop mints the
    # attempt-local handoff immediately before execution.
    python3 "$BINDER" --repo "$CVG_PROJECT_ROOT_DIR" --tool-home "$CVG_HOME_DIR" "${BIND_ARGS[@]}"
    ;;
  capture)
    # Pass 0 gate: locate the brief, route to the idea-to-brd exit contract.
    # Gate path is an exact pass-through (exec, zero decoration) — R0.P
    # proves by byte-diff. Discovery messages exist ONLY on the exit-2 path,
    # and every exit-2 path still ends in the CHECK_BRD=USAGE_ERROR token
    # (agents are users — never make a harness parse prose).
    GATE="$CVG_HOME_DIR/skills/idea-to-brd/scripts/check-brd.sh"
    CAP_FLAGS=""
    CAP_TARGET=""
    CAP_KIND="brd"
    CAP_DRAFT=0
    CAP_NOGO=0
    for A in "$@"; do
      case "$A" in
        --draft) CAP_FLAGS="$CAP_FLAGS --draft"; CAP_DRAFT=1 ;;
        --no-go) CAP_FLAGS="$CAP_FLAGS --no-go"; CAP_NOGO=1; CAP_KIND="no-go" ;;
        -*)
          ui_err "unknown capture flag '$A' — expected --draft or --no-go"
          printf 'CHECK_BRD=USAGE_ERROR\n'
          exit 2
          ;;
        *)       CAP_TARGET="$A" ;;
      esac
    done
    if [ "$CAP_DRAFT" -eq 1 ] && [ "$CAP_NOGO" -eq 1 ]; then
      ui_err "--draft and --no-go conflict — a record is a BRD draft or a no-go, never both"
      printf 'CHECK_BRD=USAGE_ERROR\n'
      exit 2
    fi
    if [ -z "$CAP_TARGET" ]; then
      CAP_N=0
      CAP_LIST=""
      # Typed folder first (cvg/docs/brd/*.md — the canonical layout since
      # 0.1.0: one folder per artifact type), then the legacy flat prefix, so
      # workspaces created before the layout change keep gating untouched.
      for F in "cvg/docs/${CAP_KIND}/"*.md "docs/${CAP_KIND}/"*.md \
               "cvg/docs/${CAP_KIND}-"*.md "docs/${CAP_KIND}-"*.md; do
        [ -f "$F" ] || continue
        CAP_N=$((CAP_N + 1))
        CAP_TARGET="$F"
        CAP_LIST="${CAP_LIST}  ${F}
"
      done
      if [ "$CAP_N" -eq 0 ]; then
        ui_err "no ${CAP_KIND} document found under cvg/docs/${CAP_KIND}/ (or the legacy ${CAP_KIND}-*.md) from '$PWD' — pass the file: cvg capture [--draft|--no-go] <file>"
        printf 'CHECK_BRD=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$CAP_N" -gt 1 ]; then
        ui_err "ambiguous: $CAP_N ${CAP_KIND} documents found — pass one explicitly:"
        printf '%s' "$CAP_LIST" >&2
        printf 'CHECK_BRD=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # CAP_FLAGS is a controlled flag list (--draft/--no-go only)
    exec bash "$GATE" $CAP_FLAGS "$CAP_TARGET"
    ;;
  intent)
    # Pass 1 gate: locate the tech-spec, route to the brd-docs-to-tech-req
    # exit contract. Gate path is an exact pass-through (exec, zero
    # decoration) — R1.P proves by byte-diff. Discovery/flag errors exist
    # ONLY on the exit-2 path and still end in the machine token.
    GATE="$CVG_HOME_DIR/skills/brd-docs-to-tech-req/scripts/check-tech-spec.sh"
    INT_FLAGS=""
    INT_TARGET=""
    for A in "$@"; do
      case "$A" in
        --draft) INT_FLAGS="$INT_FLAGS --draft" ;;
        -*)
          ui_err "unknown intent flag '$A' — expected --draft"
          printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
          exit 2
          ;;
        *)       INT_TARGET="$A" ;;
      esac
    done
    if [ -z "$INT_TARGET" ]; then
      INT_N=0
      INT_LIST=""
      # Typed folder first, legacy flat prefix second (see cvg capture).
      for F in cvg/docs/tech-spec/*.md docs/tech-spec/*.md \
               cvg/docs/tech-spec-*.md docs/tech-spec-*.md; do
        [ -f "$F" ] || continue
        INT_N=$((INT_N + 1))
        INT_TARGET="$F"
        INT_LIST="${INT_LIST}  ${F}
"
      done
      if [ "$INT_N" -eq 0 ]; then
        ui_err "no tech-spec found under cvg/docs/tech-spec/ (or the legacy tech-spec-*.md) from '$PWD' — pass the file: cvg intent [--draft] <file>"
        printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$INT_N" -gt 1 ]; then
        ui_err "ambiguous: $INT_N tech-spec documents found — pass one explicitly:"
        printf '%s' "$INT_LIST" >&2
        printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # INT_FLAGS is a controlled flag list (--draft only)
    exec bash "$GATE" $INT_FLAGS "$INT_TARGET"
    ;;
  structure)
    # Pass 2 gate: locate the ADR set, route to the tech-req-to-adrs checker.
    # Gate path is an exact pass-through (exec, zero decoration) — R2.P proves
    # by byte-diff. Discovery/flag errors exist ONLY on the exit-2 path and
    # still end in the machine token CHECK_ADR=USAGE_ERROR (agents are users).
    GATE="$CVG_HOME_DIR/skills/tech-req-to-adrs/scripts/scaffold-adr.sh"
    STR_FLAGS=""
    STR_DIR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --final) STR_FLAGS="$STR_FLAGS --final"; shift ;;
        --dir)
          if [ $# -lt 2 ]; then
            ui_err "--dir needs a path — cvg structure [--final] --dir <adr-dir>"
            printf 'CHECK_ADR=USAGE_ERROR\n'
            exit 2
          fi
          STR_DIR="$2"; shift 2 ;;
        --dir=*) STR_DIR="${1#--dir=}"; shift ;;
        -*)
          ui_err "unknown structure flag '$1' — expected --final or --dir <path>"
          printf 'CHECK_ADR=USAGE_ERROR\n'
          exit 2 ;;
        *)       STR_DIR="$1"; shift ;;
      esac
    done
    if [ -z "$STR_DIR" ]; then
      STR_N=0
      STR_LIST=""
      for D in cvg/docs/adrs docs/adrs; do
        [ -d "$D" ] || continue
        ls "$D"/[0-9][0-9][0-9][0-9]-*.md >/dev/null 2>&1 || continue
        STR_N=$((STR_N + 1))
        STR_DIR="$D"
        STR_LIST="${STR_LIST}  ${D}
"
      done
      if [ "$STR_N" -eq 0 ]; then
        ui_err "no ADR set (docs/adrs/ with NNNN-*.md) found under cvg/docs/ or docs/ from '$PWD' — pass it: cvg structure [--final] --dir <adr-dir>"
        printf 'CHECK_ADR=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$STR_N" -gt 1 ]; then
        ui_err "ambiguous: $STR_N ADR directories found — pass one explicitly:"
        printf '%s' "$STR_LIST" >&2
        printf 'CHECK_ADR=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # STR_FLAGS is a controlled flag list (--final only)
    exec bash "$GATE" --check $STR_FLAGS --dir "$STR_DIR"
    ;;
  _observe-decomposition)
    # Private, read-only compatibility observation for snapshots of historical
    # v0.1 workspaces. This validates existing lane evidence; it never creates
    # a decomposition and is intentionally absent from the public CLI matrix.
    GATE="$CVG_HOME_DIR/skills/reqs-to-swimlane-plans/scripts/new-plan.sh"
    DEC_N=0
    DEC_DIR=""
    for D in cvg/swimlanes cvg/sketch swimlanes sketch; do
      [ -d "$D" ] || continue
      _cvg_has_lane "$D" || continue
      DEC_N=$((DEC_N + 1))
      DEC_DIR="$D"
    done
    if [ "$DEC_N" -eq 0 ]; then
      printf 'CHECK_PLAN=EMPTY\n'
      exit 2
    fi
    if [ "$DEC_N" -gt 1 ]; then
      ui_err "multiple historical decomposition trees are present"
      printf 'CHECK_PLAN=USAGE_ERROR\n'
      exit 2
    fi
    exec bash "$GATE" --check --dir "$DEC_DIR"
    ;;
  decompose)
    # Compatibility surface only. Seamwise owns decomposition; Converge passes
    # the recipe through the same coordinator used by `compose prepare`.
    DEC_SOURCE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --source)
          if [ $# -lt 2 ]; then
            ui_err "--source needs a recipe — cvg decompose --source <recipe>"
            printf 'COMPOSE=BLOCKED\n'
            exit 2
          fi
          DEC_SOURCE="$2"; shift 2 ;;
        --source=*) DEC_SOURCE="${1#--source=}"; shift ;;
        --dir|--dir=*)
          ui_err "cvg decompose --dir was retired in 0.2.0; use cvg decompose --source <recipe> or cvg compose prepare --source <recipe>"
          printf 'COMPOSE=BLOCKED\n'
          exit 2 ;;
        -*)
          ui_err "unknown decompose flag '$1' — expected --source <recipe>"
          printf 'COMPOSE=BLOCKED\n'
          exit 2 ;;
        *)
          ui_err "decompose requires an explicit --source <recipe>"
          printf 'COMPOSE=BLOCKED\n'
          exit 2 ;;
      esac
    done
    if [ -z "$DEC_SOURCE" ]; then
      ui_err "decompose requires --source <recipe>"
      printf 'COMPOSE=BLOCKED\n'
      exit 2
    fi
    COMPOSER="$CVG_HOME_DIR/bin/_cvg_compose.py"
    [ -f "$COMPOSER" ] || {
      ui_err "Converge composition coordinator is missing under $CVG_HOME_DIR/bin"
      printf 'COMPOSE=BLOCKED\n'
      exit 2
    }
    exec python3 "$COMPOSER" \
      --project-root "$CVG_PROJECT_ROOT_DIR" \
      --cvg-version "$CVG_VERSION" \
      --seamwise-bin "${CVG_SEAMWISE_BIN:-}" \
      --taskspec-bin "$TASKSPEC_BIN" \
      prepare --source "$DEC_SOURCE"
    ;;
  review)
    # Pass 4 · Consensus. Two modes:
    #   cvg review --adversary codex|kimi|claude   dispatch a headless adversary
    #   cvg review [--check]                        gate the stamped objection log
    # The referee frames + dispatches + gates; it never calls an LLM (the engine
    # CLI authenticates itself). Discovery mirrors decompose.
    GATE="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/check-consensus-gate.sh"
    DISPATCH="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/dispatch-review.sh"
    DISPATCH_MULTI="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/dispatch-review-multi.sh"
    REV_MODE="check"; REV_ADV=""; REV_DIR=""; REV_TMO=""
    REV_IDS=""; REV_DISP=""; REV_BY=""; REV_OWNER=""; REV_RISK=""; REV_NOTE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --check)     REV_MODE="check"; shift ;;
        --adversary) REV_MODE="dispatch"; REV_ADV="${2:-}"; shift 2 ;;
        --dir)       REV_DIR="${2:-}"; shift 2 ;;
        --dir=*)     REV_DIR="${1#--dir=}"; shift ;;
        # The wrapped dispatcher has always documented a wall-clock cap
        # (--timeout, default 300s) and the referee used to swallow it, so a
        # review that outran the cap had NO way to ask for more through the
        # CLI — you had to reach past cvg to the script, which is exactly what
        # the CLI exists to stop. A real 11-file plan set hit this on first use.
        --timeout)   REV_TMO="${2:-}"; shift 2 ;;
        # Recording the owner's decision — the one input Pass 4 cannot derive.
        --resolve)   REV_MODE="resolve"; REV_IDS="${2:-}"; shift 2 ;;
        --fix)       REV_DISP="FIX"; shift ;;
        --accept)    REV_DISP="ACCEPT"; shift ;;
        --owner)     REV_OWNER="${2:-}"; shift 2 ;;
        --risk)      REV_RISK="${2:-}"; shift 2 ;;
        --note)      REV_NOTE="${2:-}"; shift 2 ;;
        --by)        REV_BY="${2:-}"; shift 2 ;;
        --timeout=*) REV_TMO="${1#--timeout=}"; shift ;;
        -*)          ui_err "unknown review flag '$1' — expected --check | --adversary <e> [--timeout <secs>] | --resolve <id|all> --fix|--accept [--owner N --risk W] [--note T] [--by N]  [--dir <sketch>]"
                     printf 'CHECK_CONSENSUS=USAGE_ERROR\n'; exit 2 ;;
        *)           REV_DIR="$1"; shift ;;
      esac
    done
    if [ -z "$REV_DIR" ]; then
      REV_N=0
      for D in cvg/swimlanes cvg/sketch swimlanes sketch; do
        [ -d "$D" ] || continue
        _cvg_has_lane "$D" || continue
        REV_N=$((REV_N + 1)); REV_DIR="$D"
      done
      if [ "$REV_N" -ne 1 ]; then
        ui_err "no unique swimlane tree (cvg/swimlanes/<seam>/, or the legacy cvg/sketch/) under cvg/ or . from '$PWD' — pass --dir <sketch>"
        printf 'CHECK_CONSENSUS=USAGE_ERROR\n'; exit 2
      fi
    fi
    if [ "$REV_MODE" = "resolve" ]; then
      if [ -z "$REV_IDS" ]; then
        ui_err "--resolve needs an objection id, a comma-list, or 'all'"
        printf 'RESOLVE=USAGE_ERROR\n'; exit 2
      fi
      case "$REV_DISP" in
        FIX|ACCEPT) : ;;
        *) ui_err "--resolve needs --fix or --accept (ACCEPT also needs --owner and --risk)"
           printf 'RESOLVE=USAGE_ERROR\n'; exit 2 ;;
      esac
      cvg_review_resolve "$REV_DIR/.consensus/objection-log.json" \
        "$REV_IDS" "$REV_DISP" "$REV_BY" "$REV_OWNER" "$REV_RISK" "$REV_NOTE"
      exit $?
    fi
    if [ "$REV_MODE" = "dispatch" ]; then
      REV_ARGS=(--adversary "$REV_ADV" --dir "$REV_DIR")
      [ -n "$REV_TMO" ] && REV_ARGS+=(--timeout "$REV_TMO")
      case "$REV_ADV" in
        *,*) exec bash "$DISPATCH_MULTI" "${REV_ARGS[@]}" ;;
        *)   exec bash "$DISPATCH" "${REV_ARGS[@]}" ;;
      esac
    else
      exec bash "$GATE" --dir "$REV_DIR"
    fi
    ;;
  lane)
    # Route work to the lane it earns. Advisory to a human, hard-floored against
    # a machine: it can never waive a gate, only pick which passes to run.
    LANER="$CVG_HOME_DIR/bin/cvg-classify-lane.py"
    [ -f "$LANER" ] || { ui_err "Converge lane classifier is missing under $CVG_HOME_DIR/bin"; printf 'LANE=USAGE_ERROR\n'; exit 2; }
    exec python3 "$LANER" "$@"
    ;;
  next)
    # The conductor — where does the descent stand, what comes next. Derived
    # from workspace evidence, never stored; read-only; gates stay authoritative.
    SEQUENCER="$CVG_HOME_DIR/skills/evidence-to-next-pass/scripts/next-pass.sh"
    [ -f "$SEQUENCER" ] || { ui_err "evidence-to-next-pass skill is incomplete under $CVG_HOME_DIR/skills"; printf 'NEXT_PASS=USAGE_ERROR\n'; exit 2; }
    NEXT_VERB="next"
    case "${1:-}" in
      pre|post) NEXT_VERB="$1"; shift ;;
    esac
    CVG_PROJECT_ROOT="$CVG_PROJECT_ROOT_DIR" exec bash "$SEQUENCER" "$NEXT_VERB" "$@"
    ;;
  snapshot)
    # One canonical semantic projection for observers. The builder executes
    # only local read-only gates and parses canonical workspace files; it never
    # calls a tracker, model, or network service. Global --json keeps the
    # standard envelope and promotes this document to data.snapshot.
    if [ $# -gt 0 ]; then
      ui_err "cvg snapshot takes no arguments"
      exit 2
    fi
    SNAPSHOT_BUILDER="$CVG_HOME_DIR/bin/cvg-snapshot.py"
    [ -f "$SNAPSHOT_BUILDER" ] || {
      ui_err "snapshot builder is missing under $CVG_HOME_DIR/bin"
      exit 2
    }
    exec python3 "$SNAPSHOT_BUILDER" \
      --project-root "$CVG_PROJECT_ROOT_DIR" \
      --cvg-home "$CVG_HOME_DIR"
    ;;
  lesson)
    # The teaching companion's gate. A lesson belongs to no pass — it teaches
    # one that already closed — so this verb gates the LESSON's own structure
    # and says nothing about the descent's position.
    #
    # Exact exec pass-through to the checker (zero decoration), like every other
    # gate. Discovery and flag errors exist ONLY on the exit-2 path, and every
    # exit-2 path still ends in CHECK_LESSON=USAGE_ERROR — agents are users, so
    # a harness never has to parse prose to learn why it failed.
    GATE="$CVG_HOME_DIR/skills/pass-to-lesson/scripts/check-lesson.sh"
    [ -f "$GATE" ] || { ui_err "pass-to-lesson skill is incomplete under $CVG_HOME_DIR/skills"; printf 'CHECK_LESSON=USAGE_ERROR\n'; exit 2; }
    LES_TARGET=""
    LES_IMM=0
    LES_IMM_ARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --immutable)
          # --immutable consumes every remaining argument (the taught set),
          # exactly as the checker's own contract does. Mirroring it here keeps
          # the two surfaces from drifting into different meanings.
          LES_IMM=1; shift
          while [ $# -gt 0 ]; do LES_IMM_ARGS+=("$1"); shift; done
          ;;
        -*)
          ui_err "unknown lesson flag '$1' — expected --immutable <taught-artifact>..."
          printf 'CHECK_LESSON=USAGE_ERROR\n'
          exit 2
          ;;
        *)
          if [ -n "$LES_TARGET" ]; then
            ui_err "one lesson per gate — got '$LES_TARGET' and '$1'; teach one pass at a time"
            printf 'CHECK_LESSON=USAGE_ERROR\n'
            exit 2
          fi
          LES_TARGET="$1"; shift
          ;;
      esac
    done
    if [ "$LES_IMM" -eq 1 ] && [ "${#LES_IMM_ARGS[@]}" -eq 0 ]; then
      ui_err "--immutable needs at least one taught-artifact path — cvg lesson [<lesson>] --immutable <path>..."
      printf 'CHECK_LESSON=USAGE_ERROR\n'
      exit 2
    fi
    if [ -z "$LES_TARGET" ]; then
      LES_N=0
      LES_LIST=""
      # Typed folder first (cvg/docs/lessons/ — canonical since 0.1.0), then the
      # legacy flat layout, same rule as every other pass gate. Unlike a pass
      # artifact, lessons ACCUMULATE by design (one per taught pass), so the
      # ambiguity path is the normal steady state rather than an error to be
      # embarrassed by: name the file you just wrote. Newest-wins was rejected
      # — git does not preserve mtimes, so a fresh clone would gate a different
      # lesson than the working copy, and a gate that picks its own target
      # non-deterministically is not a gate.
      for F in cvg/docs/lessons/*.md docs/lessons/*.md; do
        [ -f "$F" ] || continue
        LES_N=$((LES_N + 1))
        LES_TARGET="$F"
        LES_LIST="${LES_LIST}  ${F}
"
      done
      if [ "$LES_N" -eq 0 ]; then
        ui_err "no lesson found under cvg/docs/lessons/ (or the legacy docs/lessons/) from '$PWD' — write one with the pass-to-lesson skill, then: cvg lesson [<file>]"
        printf 'CHECK_LESSON=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$LES_N" -gt 1 ]; then
        ui_err "ambiguous: $LES_N lessons found — pass the one you just wrote:"
        printf '%s' "$LES_LIST" >&2
        printf 'CHECK_LESSON=USAGE_ERROR\n'
        exit 2
      fi
    fi
    if [ "$LES_IMM" -eq 1 ]; then
      exec bash "$GATE" "$LES_TARGET" --immutable "${LES_IMM_ARGS[@]}"
    fi
    exec bash "$GATE" "$LES_TARGET"
    ;;
  gate)
    # The repo write fence — the one a Task-Spec cannot widen. Read-only.
    GATER="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/check-gate.py"
    [ -f "$GATER" ] || { ui_err "task-to-runtime-contract skill is incomplete under $CVG_HOME_DIR/skills"; printf 'CHECK_GATE=ERROR\n'; exit 2; }
    exec python3 "$GATER" --repo "$CVG_PROJECT_ROOT_DIR" "$@"
    ;;
  loop)
    # Pass 8 · Loop. One assigned task, a bounded RED/GREEN cycle, and one
    # settlement — local by default, because the profile's external_writes
    # policy is a real gate. This loop never picks its own work: --issue is
    # required, and the signed Task-Spec (not the issue body) is the only
    # instruction source.
    # The KERNEL is the loop; open-issue-pr.sh is only its settlement half.
    # --gate-only keeps the old single-shot behaviour for anyone who wants a
    # verdict without an agent attempting a fix.
    KERNEL="$CVG_HOME_DIR/skills/task-loop/scripts/loop-kernel.sh"
    LOOPER="$CVG_HOME_DIR/skills/task-loop/scripts/open-issue-pr.sh"
    LOOP_GATE_ONLY=0
    LOOP_ARGS=()
    LOOP_SCAN=("$@")
    LOOP_SCAN_I=0
    LOOP_SCAN_ISSUE=0
    LOOP_SCAN_HELP=0
    while [ "$LOOP_SCAN_I" -lt "${#LOOP_SCAN[@]}" ]; do
      LOOP_SCAN_ARG="${LOOP_SCAN[$LOOP_SCAN_I]}"
      case "$LOOP_SCAN_ARG" in
        --issue|--tasks-dir|--agent|--max-iterations|--max-seconds|--max-tokens|--base|--contract|--isolation|--judge|--lane|--model|--effort|--attempt-seconds)
          if [ $((LOOP_SCAN_I + 1)) -ge "${#LOOP_SCAN[@]}" ]; then
            ui_err "$LOOP_SCAN_ARG requires a value"
            printf 'TASK_LOOP=USAGE_ERROR\n'
            exit 2
          fi
          [ "$LOOP_SCAN_ARG" = "--issue" ] && LOOP_SCAN_ISSUE=1
          LOOP_SCAN_I=$((LOOP_SCAN_I + 2))
          ;;
        --issue=*) LOOP_SCAN_ISSUE=1; LOOP_SCAN_I=$((LOOP_SCAN_I + 1)) ;;
        --tasks-dir=*|--agent=*|--max-iterations=*|--max-seconds=*|--max-tokens=*|--base=*|--contract=*|--isolation=*|--judge=*|--lane=*|--model=*|--effort=*|--attempt-seconds=*)
          LOOP_SCAN_I=$((LOOP_SCAN_I + 1))
          ;;
        --gate-only|--no-agent|--allow-external-writes|--dry-run|--resume|--legacy-no-contract|--keep-worktree|--verify|--no-verify|--estimate)
          LOOP_SCAN_I=$((LOOP_SCAN_I + 1))
          ;;
        -h|--help) LOOP_SCAN_HELP=1; LOOP_SCAN_I=$((LOOP_SCAN_I + 1)) ;;
        *)
          ui_err "unknown loop argument '$LOOP_SCAN_ARG'"
          printf 'TASK_LOOP=USAGE_ERROR\n'
          exit 2
          ;;
      esac
    done
    if [ "$LOOP_SCAN_ISSUE" -eq 0 ] && [ "$LOOP_SCAN_HELP" -eq 0 ]; then
      ui_err "--issue is required. This loop never picks its own task."
      printf 'TASK_LOOP=USAGE_ERROR\n'
      exit 2
    fi
    if [ "$CVG_DRY_RUN" -ne 1 ]; then
      cvg_ensure_local_excludes || {
        ui_err "could not establish local boundaries for attempt evidence"
        printf 'TASK_LOOP=ERROR\n'
        exit 4
      }
    fi
    for A in "$@"; do
      case "$A" in
        --gate-only) LOOP_GATE_ONLY=1 ;;
        *)           LOOP_ARGS+=("$A") ;;
      esac
    done
    # The kernel's own dry-run reports the resolved budgets, which is the part
    # worth seeing before an unattended run. cvg strips --dry-run globally, so
    # hand it back.
    [ "$CVG_DRY_RUN" -eq 1 ] && LOOP_ARGS+=(--dry-run)
    if [ "$LOOP_GATE_ONLY" -eq 1 ]; then
      [ -f "$LOOPER" ] || { ui_err "task-loop skill is incomplete under $CVG_HOME_DIR/skills"; printf 'TASK_LOOP=USAGE_ERROR\n'; exit 2; }
      exec bash "$LOOPER" ${LOOP_ARGS[@]+"${LOOP_ARGS[@]}"}
    fi
    [ -f "$KERNEL" ] || { ui_err "task-loop skill is incomplete under $CVG_HOME_DIR/skills"; printf 'TASK_LOOP=USAGE_ERROR\n'; exit 2; }
    exec bash "$KERNEL" ${LOOP_ARGS[@]+"${LOOP_ARGS[@]}"}
    ;;
  verify)
    # Tier-2 adversarial verification — a different-family engine grades the diff
    # against the spec's intent and the holdout it never saw. Fails closed.
    VERIFIER="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/verify-work.py"
    [ -f "$VERIFIER" ] || { ui_err "task-to-runtime-contract skill is incomplete under $CVG_HOME_DIR/skills"; printf 'CHECK_VERIFY=ERROR\n'; exit 2; }
    exec python3 "$VERIFIER" --repo "$CVG_PROJECT_ROOT_DIR" "$@"
    ;;
  doctor)
    # Engine readiness. Bare `cvg doctor` reports the Pass-4 adversary engines;
    # `cvg doctor runtime-contract` attests what the HOST can actually enforce for
    # Pass 7 (isolation primitive, runtime binary, worktree) so a contract can fail
    # closed instead of assuming a control it never had.
    case "${1:-}" in
      runtime-contract)
        shift
        ATTEST="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/attest-runtime.py"
        [ -f "$ATTEST" ] || {
          ui_err "task-to-runtime-contract skill is incomplete under $CVG_HOME_DIR/skills"
          printf 'DOCTOR_RUNTIME_CONTRACT=FAIL\n'
          exit 2
        }
        exec python3 "$ATTEST" "$@"
        ;;
      evidence)
        shift
        if [ $# -gt 0 ]; then
          ui_err "cvg doctor evidence takes no arguments"
          printf 'DOCTOR_EVIDENCE=ERROR\n'
          exit 2
        fi
        cvg_doctor_evidence
        ;;
      plugin)
        shift
        if [ $# -gt 0 ]; then
          ui_err "cvg doctor plugin takes no arguments"
          printf 'DOCTOR_PLUGIN=ERROR\n'
          exit 2
        fi
        cvg_doctor_plugin
        ;;
      host)
        shift
        if [ $# -gt 0 ]; then
          ui_err "cvg doctor host takes no arguments"
          printf 'DOCTOR_HOST=ERROR\n'
          exit 2
        fi
        cvg_doctor_host
        ;;
      "") exec bash "$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/doctor.sh" ;;
      *)
        ui_err "unknown doctor subject '${1}' — expected: (none) | host | runtime-contract | plugin | evidence"
        printf 'DOCTOR=USAGE_ERROR\n'
        exit 2
        ;;
    esac
    ;;
  register)
    # REGISTER ① — bridge signed-off Task-Specs onto a tracker board (Fork B → the Loop).
    #   cvg register [--tracker T] [--tasks-dir D] [--no-stamp-refs]   write the board (mutating)
    #   cvg register --check [--tracker T] [--tasks-dir D] [--prune]   gate the mapping (read-only)
    # The referee frames + drives the pluggable adapter (github|linear|jira); it
    # holds NO tracker credentials — the adapter authenticates itself, exactly as
    # the Pass-4 engine CLIs do. --dry-run (global) reports intent and changes
    # nothing; for the rich OFFLINE preview (cycles, DAG, edge integrity) use
    # --check, which maps cvg's --dry-run to the verifier's spec-side-only gate.
    REG="$CVG_HOME_DIR/skills/task-specs-to-issues/scripts/register.sh"
    REGVERIFY="$CVG_HOME_DIR/skills/task-specs-to-issues/scripts/verify-registration.sh"
    [ -f "$REG" ] || { ui_err "register driver not found: $REG"; exit 2; }
    REG_CHECK=0
    REG_PASS=()
    for A in "$@"; do
      case "$A" in
        --check) REG_CHECK=1 ;;
        --tracker|--tracker=*|--tasks-dir|--tasks-dir=*|--no-stamp-refs|--prune|--help|-h) REG_PASS+=("$A") ;;
        -*)
          ui_err "unknown register argument '$A'"
          printf 'REGISTER=USAGE_ERROR\n'
          exit 2
          ;;
        *)       REG_PASS+=("$A") ;;
      esac
    done
    # Default --tracker from .cvg/config when the caller didn't specify one
    # (setup configures; the passes consume). An explicit --tracker always wins.
    REG_HAS_TRACKER=0
    if [ "${#REG_PASS[@]}" -gt 0 ]; then
      for A in "${REG_PASS[@]}"; do
        case "$A" in --tracker|--tracker=*) REG_HAS_TRACKER=1 ;; esac
      done
    fi
    if [ "$REG_HAS_TRACKER" -eq 0 ]; then
      CFG_TRACKER="$(cvg_config_get tracker)"
      if [ -n "$CFG_TRACKER" ]; then
        REG_PASS=(--tracker "$CFG_TRACKER" ${REG_PASS[@]+"${REG_PASS[@]}"})
        printf '%susing configured tracker: %s (from .cvg/config)%s\n' "$UI_DIM" "$CFG_TRACKER" "$UI_RESET" >&2
      fi
    fi
    # Find the specs the same way passes 0-3 find their inputs: the cvg/
    # workspace first, then the bare directory. Pass 6 was the only pass that
    # did not know about `cvg/`, so `cvg register` failed out of the box in a
    # standard workspace — the exact layout cvg/INDEX.md prescribes.
    REG_HAS_DIR=0
    if [ "${#REG_PASS[@]}" -gt 0 ]; then
      for A in "${REG_PASS[@]}"; do
        case "$A" in --tasks-dir|--tasks-dir=*) REG_HAS_DIR=1 ;; esac
      done
    fi
    if [ "$REG_HAS_DIR" -eq 0 ]; then
      if [ -d "$TASKSPEC_BACKLOG_DIR" ]; then
        REG_PASS=(--tasks-dir "$TASKSPEC_BACKLOG_DIR" ${REG_PASS[@]+"${REG_PASS[@]}"})
      fi
    fi
    cvg_export_linear_team   # bridge the non-secret Linear team UUID from config (key stays in env)
    cvg_export_spec_base     # bridge the repo base URL so issues link back to their spec
    cvg_export_identity      # bridge the .cvg/identity PATH for assignee resolution
    # A live register may create projection.lock. Establish its local-only Git
    # boundary before the adapter writes; the read-only parity gate stays pure.
    [ "$REG_CHECK" -eq 1 ] || cvg_ensure_local_excludes
    cvg_export_projection    # bridge the projection gate + logical names for T3 structure (default off)
    if [ "$REG_CHECK" -eq 1 ]; then
      # Read-only gate. cvg strips --dry-run into CVG_DRY_RUN; re-add it as the
      # verifier's spec-side-only flag so `cvg register --check --dry-run` is offline.
      [ "$CVG_DRY_RUN" -eq 1 ] && REG_PASS+=(--dry-run)
      exec bash "$REGVERIFY" ${REG_PASS[@]+"${REG_PASS[@]}"}
    else
      exec bash "$REG" ${REG_PASS[@]+"${REG_PASS[@]}"}
    fi
    ;;
  setup)
    # SETUP — the guided connectivity surface. `cvg setup` scans every moving part
    # (engines · trackers · [index · memory, planned]) and reports readiness + the
    # exact next step. `cvg setup tracker <t>` validates a backend (adapter
    # preflight) and records the CHOICE in .cvg/config. Referee-safe: records
    # choices, NEVER credentials — secrets resolve at runtime from the environment.
    SUB="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$SUB" in
      status)     cvg_setup_status "$@" ;;
      signing)    cvg_setup_signing "$@" ;;
      tracker)    cvg_setup_tracker "$@" ;;
      repo)       cvg_setup_repo "$@" ;;
      identity)   cvg_setup_identity "$@" ;;
      key)
        # Store a tracker key ONCE, outside the repo. cvg still records only
        # choices in .cvg/ — the secret goes to the OS keychain (or a 0600 file
        # in ~/.config), never to the repository and never through .cvg/config.
        KEYTOOL="$CVG_HOME_DIR/skills/task-specs-to-issues/scripts/tracker-key.sh"
        [ -f "$KEYTOOL" ] || { ui_err "task-specs-to-issues skill is incomplete"; printf 'TRACKER_KEY=ERROR\n'; exit 2; }
        _kt_tracker="${1:-$(cvg_config_get tracker)}"; : "${_kt_tracker:=linear}"
        exec bash "$KEYTOOL" set "$_kt_tracker"
        ;;
      projection) cvg_setup_projection "$@" ;;
      harness)
        # Scaffold the project ROUTER only (~50 lines). cvg never generates
        # doctrine: auto-written context files measurably degrade agents.
        SCAFFOLD="$CVG_HOME_DIR/skills/task-to-runtime-contract/scripts/scaffold-router.py"
        [ -f "$SCAFFOLD" ] || { ui_err "task-to-runtime-contract skill is incomplete"; printf 'SETUP_HARNESS=USAGE_ERROR\n'; exit 2; }
        exec python3 "$SCAFFOLD" --repo "$CVG_PROJECT_ROOT_DIR" "$@"
        ;;
      engines)
        if [ $# -gt 0 ]; then
          ui_err "cvg setup engines takes no arguments"
          printf 'SETUP=USAGE_ERROR\n'
          exit 2
        fi
        exec bash "$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/doctor.sh"
        ;;
      *)          ui_err "unknown setup part '$SUB' — expected: status | signing | tracker <t> | key [t] | repo | identity | projection | harness | engines"
                  printf 'SETUP=USAGE_ERROR\n'; exit 2 ;;
    esac
    ;;
  eval)       route_taskspec run "$@" ;;
  lint)       route_taskspec lint "$@" ;;
  transition) cvg_transition "$@" ;;
  ready)      route_taskspec ready "$@" ;;
  version|--version|-v)
    if [ $# -gt 0 ]; then
      ui_err "cvg version takes no arguments"
      exit 2
    fi
    cmd_version
    exit 0
    ;;
  agent-context|manifest)
    if [ $# -gt 0 ]; then
      ui_err "cvg agent-context takes no arguments"
      exit 2
    fi
    CONTEXT_BUILDER="$CVG_HOME_DIR/bin/cvg-agent-context.py"
    MATRIX="$CVG_HOME_DIR/contracts/cli-command-matrix.json"
    [ -f "$CONTEXT_BUILDER" ] && [ -f "$MATRIX" ] || {
      ui_err "agent-context builder or canonical CLI command matrix is missing"
      exit 2
    }
    exec python3 "$CONTEXT_BUILDER" --matrix "$MATRIX" --version "$CVG_VERSION"
    ;;
  *)
    ui_err "unknown command '$CMD' — run 'cvg help' for the command map"
    exit 2
    ;;
esac
