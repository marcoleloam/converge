  printf '%sglobal flags: --json (uniform envelope, any position) · --dry-run (no mutation)%s\n' "$UI_DIM" "$UI_RESET"
  printf '%senv: CVG_HOME · CVG_PROJECT_ROOT · CVG_TASKSPEC_BIN · CVG_SEAMWISE_BIN · NO_COLOR / CVG_COLOR=0|1%s\n' "$UI_DIM" "$UI_RESET"
